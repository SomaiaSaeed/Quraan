{"pageNumber":580,"ayas":[{"top":"+ 5","customMotashabehat":[],"index":26,"id":5617,"text":"وَمِنَ ٱلَّيْلِ فَٱسْجُدْ لَهُۥ وَسَبِّحْهُ لَيْلًا طَوِيلًا","text_without_tashkeel":"ومن الليل فاسجد له وسبحه ليلا طويلا","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":27,"id":5618,"text":"إِنَّ هَٰٓؤُلَآءِ يُحِبُّونَ ٱلْعَاجِلَةَ وَيَذَرُونَ وَرَآءَهُمْ يَوْمًا ثَقِيلًا","text_without_tashkeel":"إن هؤلاء يحبون العاجلة ويذرون وراءهم يوما ثقيلا","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":28,"id":5619,"text":"نَّحْنُ خَلَقْنَٰهُمْ وَشَدَدْنَآ أَسْرَهُمْ وَإِذَا شِئْنَا بَدَّلْنَآ أَمْثَٰلَهُمْ تَبْدِيلًا","text_without_tashkeel":"نحن خلقناهم وشددنا أسرهم وإذا شئنا بدلنا أمثالهم تبديلا","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":29,"id":5620,"text":"إِنَّ هَٰذِهِۦ تَذْكِرَةٌ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ سَبِيلًا","text_without_tashkeel":"إن هذه تذكرة فمن شاء اتخذ إلى ربه سبيلا","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":30,"id":5621,"text":"وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ إِنَّ ٱللَّهَ كَانَ عَلِيمًا حَكِيمًا","text_without_tashkeel":"وما تشاءون إلا أن يشاء الله إن الله كان عليما حكيما","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":31,"id":5622,"text":"يُدْخِلُ مَن يَشَآءُ فِى رَحْمَتِهِۦ وَٱلظَّٰلِمِينَ أَعَدَّ لَهُمْ عَذَابًا أَلِيمًۢا","text_without_tashkeel":"يدخل من يشاء في رحمته والظالمين أعد لهم عذابا أليما","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":1,"id":5623,"text":"وَٱلْمُرْسَلَٰتِ عُرْفًا","text_without_tashkeel":"والمرسلات عرفا","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":2,"id":5624,"text":"فَٱلْعَٰصِفَٰتِ عَصْفًا","text_without_tashkeel":"فالعاصفات عصفا","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":3,"id":5625,"text":"وَٱلنَّٰشِرَٰتِ نَشْرًا","text_without_tashkeel":"والناشرات نشرا","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":4,"id":5626,"text":"فَٱلْفَٰرِقَٰتِ فَرْ