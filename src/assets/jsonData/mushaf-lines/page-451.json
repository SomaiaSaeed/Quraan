Basmala":false,"isSuraStart":false},{"lineNumber":12,"segments":[{"verseKey":"37:147","wordPositions":[6,7]},{"verseKey":"37:148","wordPositions":[1,2,3,4,5]},{"verseKey":"37:149","wordPositions":[1]}],"text":"يَزِيدُونَ ﴿147﴾ فَـَٔامَنُوا۟ فَمَتَّعْنَٰهُمْ إِلَىٰ حِينٍ ﴿148﴾ فَٱسْتَفْتِهِمْ","isBasmala":false,"isSuraStart":false},{"lineNumber":13,"segments":[{"verseKey":"37:149","wordPositions":[2,3,4,5,6]},{"verseKey":"37:150","wordPositions":[1,2,3,4]}],"text":"أَلِرَبِّكَ ٱلْبَنَاتُ وَلَهُمُ ٱلْبَنُونَ ﴿149﴾ أَمْ خَلَقْنَا ٱلْمَلَٰٓئِكَةَ إِنَٰثًا","isBasmala":false,"isSuraStart":false},{"lineNumber":14,"segments":[{"verseKey":"37:150","wordPositions":[5,6,7]},{"verseKey":"37:151","wordPositions":[1,2,3,4,5,6]},{"verseKey":"37:152","wordPositions":[1]}],"text":"وَهُمْ شَٰهِدُونَ ﴿150﴾ أَلَآ إِنَّهُم مِّنْ إِفْكِهِمْ لَيَقُولُونَ ﴿151﴾ وَلَدَ","isBasmala":false,"isSuraStart":false},{"lineNumber":15,"segments":[{"verseKey":"37:152","wordPositions":[2,3,4,5]},{"verseKey":"37:153","wordPositions":[1,2,3,4,5]}],"text":"ٱللَّهُ وَإِنَّهُمْ لَكَٰذِبُونَ ﴿152﴾ أَصْطَفَى ٱلْبَنَاتِ عَلَى ٱلْبَنِينَ ﴿153﴾","isBasmala":false,"isSuraStart":false}]}