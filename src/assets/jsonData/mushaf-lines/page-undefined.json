{"lines":[{"lineNumber":3,"segments":[{"verseKey":"112:1","wordPositions":[1,2,3,4,5]},{"verseKey":"112:2","wordPositions":[1,2,3]},{"verseKey":"112:3","wordPositions":[1,2,3,4,5]}],"text":"قُلْ هُوَ ٱللَّهُ أَحَدٌ ﴿1﴾ ٱللَّهُ ٱلصَّمَدُ ﴿2﴾ لَمْ يَلِدْ وَلَمْ يُولَدْ ﴿3﴾","isBasmala":false,"isSuraStart":true},{"lineNumber":4,"segments":[{"verseKey":"112:4","wordPositions":[1,2,3,4,5,6]}],"text":"وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ ﴿4﴾","isBasmala":false,"isSuraStart":false},{"lineNumber":7,"segments":[{"verseKey":"113:1","wordPositions":[1,2,3,4,5]},{"verseKey":"113:2","wordPositions":[1,2,3,4,5]},{"verseKey":"113:3","wordPositions":[1,2]}],"text":"قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ ﴿1﴾ مِن شَرِّ مَا خَلَقَ ﴿2﴾ وَمِن شَرِّ","isBasmala":false,"isSuraStart":true},{"lineNumber":8,"segments":[{"verseKey":"113:3","wordPositions":[3,4,5,6]},{"verseKey":"113:4","wordPositions":[1,2,3,4,5,6]}],"text":"غَاسِقٍ إِذَا وَقَبَ ﴿3﴾ وَمِن شَرِّ ٱلنَّفَّٰثَٰتِ فِى ٱلْعُقَدِ ﴿4﴾","isBasmala":false,"isSuraStart":false},{"lineNumber":9,"segments":[{"verseKey":"113:5","wordPositions":[1,2,3,4,5,6]}],"text":"وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ ﴿5﴾","isBasmala":false,"isSuraStart":false},{"lineNumber":12,"segments":[{"verseKey":"114:1","wordPositions":[1,2,3,4,5]},{"verseKey":"114:2","wordPositions":[1,2,3]},{"verseKey":"114:3","wordPositions":[1]}],"text":"قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ ﴿1﴾ مَلِكِ ٱلنَّاسِ ﴿2﴾ إِلَٰهِ","isBasmala":false,"isSuraStart":true},{"lineNumber":13,"segments":[{"verseKey":"114:3","wordPositions":[2,3]},{"verseKey":"114:4","wordPositions":[1,2,3,4,5]},{"verseKey":"114:5","wordPositions":[1]}],"text":"ٱلنَّاسِ ﴿3﴾ مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ ﴿4﴾ ٱلَّذِى","isBasmala":false,"isSuraStart":false},{"lineNumber":14,"segments":[{"verseKey":"114:5","wordPositions":[2,3,4,5,6]}],"text":"يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ ﴿5﴾","isBasmala":false,"isSuraStart":false},{"lineNumber":15,"segments":[{"verseKey":"114:6","wordPositions":[1,2,3,4]}],"text":"مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ ﴿6﴾","isBasmala":false,"isSuraStart":false}]}