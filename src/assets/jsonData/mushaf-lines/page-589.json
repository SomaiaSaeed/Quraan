6]},{"verseKey":"84:22","wordPositions":[1,2,3,4]}],"text":"عَلَيْهِمُ ٱلْقُرْءَانُ لَا يَسْجُدُونَ ﴿21﴾ بَلِ ٱلَّذِينَ كَفَرُوا۟ يُكَذِّبُونَ ﴿22﴾","isBasmala":false,"isSuraStart":false},{"lineNumber":15,"segments":[{"verseKey":"84:22","wordPositions":[5]},{"verseKey":"84:23","wordPositions":[1,2,3,4,5]},{"verseKey":"84:24","wordPositions":[1,2,3,4]}],"text":" وَٱللَّهُ أَعْلَمُ بِمَا يُوعُونَ ﴿23﴾ فَبَشِّرْهُم بِعَذَابٍ أَلِيمٍ ﴿24﴾","isBasmala":false,"isSuraStart":false}]}