﴾ فَٱصْبِرْ صَبْرًا جَمِيلًا ﴿5﴾","isBasmala":false,"isSuraStart":false},{"lineNumber":14,"segments":[{"verseKey":"70:5","wordPositions":[4]},{"verseKey":"70:6","wordPositions":[1,2,3,4]},{"verseKey":"70:7","wordPositions":[1,2,3]},{"verseKey":"70:8","wordPositions":[1,2,3]}],"text":" إِنَّهُمْ يَرَوْنَهُۥ بَعِيدًا ﴿6﴾ وَنَرَىٰهُ قَرِيبًا ﴿7﴾ يَوْمَ تَكُونُ ٱلسَّمَآءُ","isBasmala":false,"isSuraStart":false},{"lineNumber":15,"segments":[{"verseKey":"70:8","wordPositions":[4,5]},{"verseKey":"70:9","wordPositions":[1,2,3,4]},{"verseKey":"70:10","wordPositions":[1,2,3,4,5]}],"text":"كَٱلْمُهْلِ ﴿8﴾ وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ﴿9﴾ وَلَا يَسْـَٔلُ حَمِيمٌ حَمِيمًا ﴿10﴾","isBasmala":false,"isSuraStart":false}]}