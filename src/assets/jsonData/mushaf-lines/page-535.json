Positions":[6]},{"verseKey":"56:19","wordPositions":[1,2,3,4,5,6]},{"verseKey":"56:20","wordPositions":[1,2,3]}],"text":" لَّا يُصَدَّعُونَ عَنْهَا وَلَا يُنزِفُونَ ﴿19﴾ وَفَٰكِهَةٍ مِّمَّا يَتَخَيَّرُونَ ﴿20﴾","isBasmala":false,"isSuraStart":false},{"lineNumber":3,"segments":[{"verseKey":"56:20","wordPositions":[4]},{"verseKey":"56:21","wordPositions":[1,2,3,4,5]},{"verseKey":"56:22","wordPositions":[1,2,3]},{"verseKey":"56:23","wordPositions":[1,2]}],"text":" وَلَحْمِ طَيْرٍ مِّمَّا يَشْتَهُونَ ﴿21﴾ وَحُورٌ عِينٌ ﴿22﴾ كَأَمْثَٰلِ ٱللُّؤْلُؤِ","isBasmala":false,"isSuraStart":false},{"lineNumber":4,"segments":[{"verseKey":"56:23","wordPositions":[3,4]},{"verseKey":"56:24","wordPositions":[1,2,3,4,5]},{"verseKey":"56:25","wordPositions":[1,2,3,4]}],"text":"ٱلْمَكْنُونِ ﴿23﴾ جَزَآءًۢ بِمَا كَانُوا۟ يَعْمَلُونَ ﴿24﴾ لَا يَسْمَعُونَ فِيهَا لَغْوًا","isBasmala":false,"isSuraStart":false},{"lineNumber":5,"segments":[{"verseKey":"56:25","wordPositions":[5,6,7]},{"verseKey":"56:26","wordPositions":[1,2,3,4,5]},{"verseKey":"56:27","wordPositions":[1,2,3,4]}],"text":"وَلَا تَأْثِيمًا ﴿25﴾ إِلَّا قِيلًا سَلَٰمًا سَلَٰمًا ﴿26﴾ وَأَصْحَٰبُ ٱلْيَمِينِ مَآ أَصْحَٰبُ","isBasmala":false,"isSuraStart":false},{"lineNumber":6,"segments":[{"verseKey":"56:27","wordPositions":[5,6]},{"verseKey":"56:28","wordPositions":[1,2,3,4]},{"verseKey":"56:29","wordPositions":[1,2,3]},{"verseKey":"56:30","wordPositions":[1,2]}],"text":"ٱلْيَمِينِ ﴿27﴾ فِى سِدْرٍ مَّخْضُودٍ ﴿28﴾ وَطَلْحٍ مَّنضُودٍ ﴿29﴾ وَظِلٍّ مَّمْدُودٍ ﴿30﴾","isBasmala":false,"isSuraStart":false},{"lineNumber":7,"segments":[{"verseKey":"56:30","wordPositions":[3]},{"verseKey":"56:31","wordPositions":[1,2,3]},{"verseKey":"56:32","wordPositions":[1,2,3]},{"verseKey":"56:33","wordPositions":[1,2,3,4]}],"text":" وَمَآءٍ مَّسْكُوبٍ ﴿31﴾ وَفَٰكِهَةٍ كَثِيرَةٍ ﴿32﴾ لَّا مَقْطُوعَةٍ وَلَا مَمْنُوعَةٍ ﴿33﴾","isBasmala":false,"isSuraStart":false},{"lineNumber":8,"segments":[{"verseKey":"56:33","wordPositions":[5]},{"verseKey":"56:34","wordPositions":[1,2,3]},{"verseKey":"56:35","wordPositions":[1,2,3,4]},{"verseKey":"56:36","wordPositions":[1,2]}],"text":" وَفُرُشٍ مَّرْفُوعَةٍ ﴿34﴾ إِنَّآ أَنشَأْنَٰهُنَّ إِنشَآءً ﴿35﴾ فَجَعَلْنَٰهُنَّ أَبْكَارًا ﴿36﴾","isBasmala":false,"isSuraStart":false},{"lineNumber":9,"segments":[{"verseKey":"56:36","wordPositions":[3]},{"verseKey":"56:37","wordPositions":[1,2,3]},{"verseKey":"56:38","wordPositions":[1,2,3]},{"verseKey":"56:39","wordPositions":[1,2,3,4]}],"text":" عُرُبًا أَتْرَابًا ﴿37﴾ لِّأَصْحَٰبِ ٱلْيَمِينِ ﴿38﴾ ثُلَّةٌ مِّنَ ٱلْأَوَّلِينَ ﴿39﴾","isBasmala":false,"isSuraStart":false},{"lineNumber":10,"segments":[{"verseKey":"56:40","wordPositions":[1,2,3,4]},{"verseKey":"56:41","wordPositions":[1,2,3,4,5]}],"text":"وَثُلَّةٌ مِّنَ ٱلْءَاخِرِينَ ﴿40﴾ وَأَصْحَٰبُ ٱلشِّمَالِ مَآ أَصْحَٰبُ ٱلشِّمَالِ ﴿41﴾","isBasmala":false,"isSuraStart":false},{"lineNumber":11,"segments":[{"verseKey":"56:41","wordPositions":[6]},{"verseKey":"56:42","wordPositions":[1,2,3,4]},{"verseKey":"56:43","wordPositions":[1,2,3,4]},{"verseKey":"56:44","wordPositions":[1,2]}],"text":" فِى سَمُومٍ وَحَمِيمٍ ﴿42﴾ وَظِلٍّ مِّن يَحْمُومٍ ﴿43﴾ لَّا بَارِدٍ","isBasmala":false,"isSuraStart":false},{"lineNumber":12,"segments":[{"verseKey":"56:44","wordPositions":[3,4,5]},{"verseKey":"56:45","wordPositions":[1,2,3,4,5,6]},{"verseKey":"56:46","wordPositions":[1]}],"text":"وَلَا كَرِيمٍ ﴿44﴾ إِنَّهُمْ كَانُوا۟ قَبْلَ ذَٰلِكَ مُتْرَفِينَ ﴿45﴾ وَكَانُوا۟","isBasmala":false,"isSuraStart":false},{"lineNumber":13,"segments":[{"verseKey":"56:46","wordPositions":[2,3,4,5,6]},{"verseKey":"56:47","wordPositions":[1,2,3,4,5]}],"text":"يُصِرُّونَ عَلَى ٱلْحِنثِ ٱلْعَظِيمِ ﴿46﴾ وَكَانُوا۟ يَقُولُونَ أَئِذَا مِتْنَا وَكُنَّا","isBasmala":false,"isSuraStart":false},{"lineNumber":14,"segments":[{"verseKey":"56:47","wordPositions":[6,7,8,9,10]},{"verseKey":"56:48","wordPositions":[1,2,3]},{"verseKey":"56:49","wordPositions":[1,2]}],"text":"تُرَابًا وَعِظَٰمًا أَءِنَّا لَمَبْعُوثُونَ ﴿47﴾ أَوَءَابَآؤُنَا ٱلْأَوَّ