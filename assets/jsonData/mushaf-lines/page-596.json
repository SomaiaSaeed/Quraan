{"verseKey":"92:13","wordPositions":[1,2,3,4,5]},{"verseKey":"92:14","wordPositions":[1,2,3,4]}],"text":"لَلْهُدَىٰ ﴿12﴾ وَإِنَّ لَنَا لَلْءَاخِرَةَ وَٱلْأُولَىٰ ﴿13﴾ فَأَنذَرْتُكُمْ نَارًا تَلَظَّىٰ ﴿14﴾","isBasmala":false,"isSuraStart":false},{"lineNumber":3,"segments":[{"verseKey":"92:15","wordPositions":[1,2,3,4,5]},{"verseKey":"92:16","wordPositions":[1,2,3,4]},{"verseKey":"92:17","wordPositions":[1]}],"text":"لَا يَصْلَىٰهَآ إِلَّا ٱلْأَشْقَى ﴿15﴾ ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ ﴿16﴾ وَسَيُجَنَّبُهَا","isBasmala":false,"isSuraStart":false},{"lineNumber":4,"segments":[{"verseKey":"92:17","wordPositions":[2,3]},{"verseKey":"92:18","wordPositions":[1,2,3,4,5]},{"verseKey":"92:19","wordPositions":[1,2,3,4,5]}],"text":"ٱلْأَتْقَى ﴿17﴾ ٱلَّذِى يُؤْتِى مَالَهُۥ يَتَزَكَّىٰ ﴿18﴾ وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٍ","isBasmala":false,"isSuraStart":false},{"lineNumber":5,"segments":[{"verseKey":"92:19","wordPositions":[6,7]},{"verseKey":"92:20","wordPositions":[1,2,3,4,5,6]},{"verseKey":"92:21","wordPositions":[1,2,3]}],"text":"تُجْزَىٰٓ ﴿19﴾ إِلَّا ٱبْتِغَآءَ وَجْهِ رَبِّهِ ٱلْأَعْلَىٰ ﴿20﴾ وَلَسَوْفَ يَرْضَىٰ ﴿21﴾","isBasmala":false,"isSuraStart":false},{"lineNumber":8,"segments":[{"verseKey":"93:1","wordPositions":[1,2]},{"verseKey":"93:2","wordPositions":[1,2,3,4]},{"verseKey":"93:3","wordPositions":[1,2,3,4,5,6]}],"text":"وَٱلضُّحَىٰ ﴿1﴾ وَٱلَّيْلِ إِذَا سَجَىٰ ﴿2﴾ مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ ﴿3﴾","isBasmala":false,"isSuraStart":true},{"lineNumber":9,"segments":[{"verseKey":"93:4","wordPositions":[1,2,3,4,5,6]},{"verseKey":"93:5","wordPositions":[1,2,3]}],"text":"وَلَلْءَاخِرَةُ خَيْرٌ لَّكَ مِنَ ٱلْأُولَىٰ ﴿4﴾ وَلَسَوْفَ يُعْطِيكَ رَبُّكَ","isBasmala":false,"isSuraStart":false},{"lineNumber":10,"segments":[{"verseKey":"93:5","wordPositions":[4,5]},{"verseKey":"93:6","wordPositions":[1,2,3,4,5]},{"verseKey":"93:7","wordPositions":[1,2,3]}],"text":"فَتَرْضَىٰٓ ﴿5﴾ أَلَمْ يَجِدْكَ يَتِيمًا فَـَٔاوَىٰ ﴿6﴾ وَوَجَدَكَ ضَآلًّا فَهَدَىٰ ﴿7﴾","isBasmala":false,"isSuraStart":false},{"lineNumber":11,"segments":[{"verseKey":"93:7","wordPositions":[4]},{"verseKey":"93:8","wordPositions":[1,2,3,4]},{"verseKey":"93:9","wordPositions":[1,2,3,4,5]}],"text":" وَوَجَدَكَ عَآئِلًا فَأَغْنَىٰ ﴿8﴾ فَأَمَّا ٱلْيَتِيمَ فَلَا تَقْهَرْ ﴿9﴾","isBasmala":false,"isSuraStart":false},{"lineNumber":12,"segments":[{"verseKey":"93:10","wordPositions":[1,2,3,4,5]},{"verseKey":"93:11","wordPositions":[1,2,3,4,5]}],"text":"وَأَمَّا ٱلسَّآئِلَ فَلَا تَنْهَرْ ﴿10﴾ وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ ﴿11﴾","isBasmala":false,"isSuraStart":false},{"lineNumber":15,"segments":[{"verseKey":"94:1","wordPositions":[1,2,3,4,5]},{"verseKey":"94:2","wordPositions":[1,2,3,4]}],"text":"أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ ﴿1﴾ وَوَضَعْنَا عَنكَ وِزْرَكَ ﴿2﴾","isBasmala":false,"isSuraStart":true}]}