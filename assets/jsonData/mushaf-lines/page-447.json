Positions":[1,2,3]}],"text":"فَوَٰكِهُ وَهُم مُّكْرَمُونَ ﴿42﴾ فِى جَنَّٰتِ ٱلنَّعِيمِ ﴿43﴾ عَلَىٰ سُرُرٍ مُّتَقَٰبِلِينَ ﴿44﴾","isBasmala":false,"isSuraStart":false},{"lineNumber":12,"segments":[{"verseKey":"37:44","wordPositions":[4]},{"verseKey":"37:45","wordPositions":[1,2,3,4,5,6]},{"verseKey":"37:46","wordPositions":[1,2,3]}],"text":" يُطَافُ عَلَيْهِم بِكَأْسٍ مِّن مَّعِينٍۭ ﴿45﴾ بَيْضَآءَ لَذَّةٍ لِّلشَّٰرِبِينَ ﴿46﴾","isBasmala":false,"isSuraStart":false},{"lineNumber":13,"segments":[{"verseKey":"37:46","wordPositions":[4]},{"verseKey":"37:47","wordPositions":[1,2,3,4,5,6,7,8]},{"verseKey":"37:48","wordPositions":[1,2]}],"text":" لَا فِيهَا غَوْلٌ وَلَا هُمْ عَنْهَا يُنزَفُونَ ﴿47﴾ وَعِندَهُمْ قَٰصِرَٰتُ","isBasmala":false,"isSuraStart":false},{"lineNumber":14,"segments":[{"verseKey":"37:48","wordPositions":[3,4,5]},{"verseKey":"37:49","wordPositions":[1,2,3,4]},{"verseKey":"37:50","wordPositions":[1,2,3]}],"text":"ٱلطَّرْفِ عِينٌ ﴿48﴾ كَأَنَّهُنَّ بَيْضٌ مَّكْنُونٌ ﴿49﴾ فَأَقْبَلَ بَعْضُهُمْ عَلَىٰ","isBasmala":false,"isSuraStart":false},{"lineNumber":15,"segments":[{"verseKey":"37:50","wordPositions":[4,5,6]},{"verseKey":"37:51","wordPositions":[1,2,3,4,5,6,7,8]}],"text":"بَعْضٍ يَتَسَآءَلُونَ ﴿50﴾ قَالَ قَآئِلٌ مِّنْهُمْ إِنِّى كَانَ لِى قَرِينٌ ﴿51﴾","isBasmala":false,"isSuraStart":false}]}