},{"verseKey":"20:31","wordPositions":[1,2,3,4]},{"verseKey":"20:32","wordPositions":[1,2,3,4]},{"verseKey":"20:33","wordPositions":[1,2]}],"text":"أَخِى ﴿30﴾ ٱشْدُدْ بِهِۦٓ أَزْرِى ﴿31﴾ وَأَشْرِكْهُ فِىٓ أَمْرِى ﴿32﴾ كَىْ نُسَبِّحَكَ","isBasmala":false,"isSuraStart":false},{"lineNumber":14,"segments":[{"verseKey":"20:33","wordPositions":[3,4]},{"verseKey":"20:34","wordPositions":[1,2,3]},{"verseKey":"20:35","wordPositions":[1,2,3,4,5]},{"verseKey":"20:36","wordPositions":[1,2]}],"text":"كَثِيرًا ﴿33﴾ وَنَذْكُرَكَ كَثِيرًا ﴿34﴾ إِنَّكَ كُنتَ بِنَا بَصِيرًا ﴿35﴾ قَالَ قَدْ","isBasmala":false,"isSuraStart":false},{"lineNumber":15,"segments":[{"verseKey":"20:36","wordPositions":[3,4,5,6]},{"verseKey":"20:37","wordPositions":[1,2,3,4,5,6]}],"text":"أُوتِيتَ سُؤْلَكَ يَٰمُوسَىٰ ﴿36﴾ وَلَقَدْ مَنَنَّا عَلَيْكَ مَرَّةً أُخْرَىٰٓ ﴿37﴾","isBasmala":false,"isSuraStart":false}]}