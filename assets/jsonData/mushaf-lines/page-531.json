ber":11,"segments":[{"verseKey":"55:10","wordPositions":[2,3,4]},{"verseKey":"55:11","wordPositions":[1,2,3,4,5,6]}],"text":"وَضَعَهَا لِلْأَنَامِ ﴿10﴾ فِيهَا فَٰكِهَةٌ وَٱلنَّخْلُ ذَاتُ ٱلْأَكْمَامِ ﴿11﴾","isBasmala":false,"isSuraStart":false},{"lineNumber":12,"segments":[{"verseKey":"55:12","wordPositions":[1,2,3,4,5]},{"verseKey":"55:13","wordPositions":[1,2,3,4]}],"text":"وَٱلْحَبُّ ذُو ٱلْعَصْفِ وَٱلرَّيْحَانُ ﴿12﴾ فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ﴿13﴾","isBasmala":false,"isSuraStart":false},{"lineNumber":13,"segments":[{"verseKey":"55:13","wordPositions":[5]},{"verseKey":"55:14","wordPositions":[1,2,3,4,5,6]},{"verseKey":"55:15","wordPositions":[1,2,3]}],"text":" خَلَقَ ٱلْإِنسَٰنَ مِن صَلْصَٰلٍ كَٱلْفَخَّارِ ﴿14﴾ وَخَلَقَ ٱلْجَآنَّ مِن","isBasmala":false,"isSuraStart":false},{"lineNumber":14,"segments":[{"verseKey":"55:15","wordPositions":[4,5,6,7]},{"verseKey":"55:16","wordPositions":[1,2,3,4,5]},{"verseKey":"55:17","wordPositions":[1]}],"text":"مَّارِجٍ مِّن نَّارٍ ﴿15﴾ فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ﴿16﴾ رَبُّ","isBasmala":false,"isSuraStart":false},{"lineNumber":15,"segments":[{"verseKey":"55:17","wordPositions":[2,3,4,5]},{"verseKey":"55:18","wordPositions":[1,2,3,4,5]}],"text":"ٱلْمَشْرِقَيْنِ وَرَبُّ ٱلْمَغْرِبَيْنِ ﴿17﴾ فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ﴿18﴾","isBasmala":false,"isSuraStart":false}]}