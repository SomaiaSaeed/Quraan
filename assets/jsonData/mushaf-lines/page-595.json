:8","wordPositions":[3,4]},{"verseKey":"91:9","wordPositions":[1,2,3,4,5]},{"verseKey":"91:10","wordPositions":[1,2,3,4]}],"text":"وَتَقْوَىٰهَا ﴿8﴾ قَدْ أَفْلَحَ مَن زَكَّىٰهَا ﴿9﴾ وَقَدْ خَابَ مَن دَسَّىٰهَا ﴿10﴾","isBasmala":false,"isSuraStart":false},{"lineNumber":8,"segments":[{"verseKey":"91:10","wordPositions":[5]},{"verseKey":"91:11","wordPositions":[1,2,3,4]},{"verseKey":"91:12","wordPositions":[1,2,3,4]},{"verseKey":"91:13","wordPositions":[1,2]}],"text":" كَذَّبَتْ ثَمُودُ بِطَغْوَىٰهَآ ﴿11﴾ إِذِ ٱنۢبَعَثَ أَشْقَىٰهَا ﴿12﴾ فَقَالَ لَهُمْ","isBasmala":false,"isSuraStart":false},{"lineNumber":9,"segments":[{"verseKey":"91:13","wordPositions":[3,4,5,6,7,8]},{"verseKey":"91:14","wordPositions":[1,2,3]}],"text":"رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقْيَٰهَا ﴿13﴾ فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ","isBasmala":false,"isSuraStart":false},{"lineNumber":10,"segments":[{"verseKey":"91:14","wordPositions":[4,5,6,7,8]},{"verseKey":"91:15","wordPositions":[1,2,3,4]}],"text":"عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّىٰهَا ﴿14﴾ وَلَا يَخَافُ عُقْبَٰهَا ﴿15﴾","isBasmala":false,"isSuraStart":false},{"lineNumber":13,"segments":[{"verseKey":"92:1","wordPositions":[1,2,3,4]},{"verseKey":"92:2","wordPositions":[1,2,3,4]},{"verseKey":"92:3","wordPositions":[1,2,3,4,5]}],"text":"وَٱلَّيْلِ إِذَا يَغْشَىٰ ﴿1﴾ وَٱلنَّهَارِ إِذَا تَجَلَّىٰ ﴿2﴾ وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ ﴿3﴾","isBasmala":false,"isSuraStart":true},{"lineNumber":14,"segments":[{"verseKey":"92:4","wordPositions":[1,2,3,4]},{"verseKey":"92:5","wordPositions":[1,2,3,4,5]},{"verseKey":"92:6","wordPositions":[1,2,3]}],"text":"إِنَّ سَعْيَكُمْ لَشَتَّىٰ ﴿4﴾ فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ ﴿5﴾ وَصَدَّقَ بِٱلْحُسْنَىٰ ﴿6﴾","isBasmala":false,"isSuraStart":false},{"lineNumber":15,"segments":[{"verseKey":"92:7","wordPositions":[1,2,3]},{"verseKey":"92:8","wordPositions":[1,2,3,4,5]},{"verseKey":"92:9","wordPositions":[1,2,3]}],"text":"فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ ﴿7﴾ وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ ﴿8﴾ وَكَذَّب