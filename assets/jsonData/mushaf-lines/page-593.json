,3,4]},{"verseKey":"89:13","wordPositions":[1,2,3,4]}],"text":"ٱلْبِلَٰدِ ﴿11﴾ فَأَكْثَرُوا۟ فِيهَا ٱلْفَسَادَ ﴿12﴾ فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ","isBasmala":false,"isSuraStart":false},{"lineNumber":10,"segments":[{"verseKey":"89:13","wordPositions":[5,6]},{"verseKey":"89:14","wordPositions":[1,2,3,4]},{"verseKey":"89:15","wordPositions":[1,2,3,4,5]}],"text":"عَذَابٍ ﴿13﴾ إِنَّ رَبَّكَ لَبِٱلْمِرْصَادِ ﴿14﴾ فَأَمَّا ٱلْإِنسَٰنُ إِذَا مَا ٱبْتَلَىٰهُ","isBasmala":false,"isSuraStart":false},{"lineNumber":11,"segments":[{"verseKey":"89:15","wordPositions":[6,7,8,9,10,11,12]},{"verseKey":"89:16","wordPositions":[1,2,3,4]}],"text":"رَبُّهُۥ فَأَكْرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّىٓ أَكْرَمَنِ ﴿15﴾ وَأَمَّآ إِذَا مَا ٱبْتَلَىٰهُ","isBasmala":false,"isSuraStart":false},{"lineNumber":12,"segments":[{"verseKey":"89:16","wordPositions":[5,6,7,8,9,10,11]},{"verseKey":"89:17","wordPositions":[1,2,3,4]}],"text":"فَقَدَرَ عَلَيْهِ رِزْقَهُۥ فَيَقُولُ رَبِّىٓ أَهَٰنَنِ ﴿16﴾ كَلَّا بَل لَّا تُكْرِمُونَ","isBasmala":false,"isSuraStart":false},{"lineNumber":13,"segments":[{"verseKey":"89:17","wordPositions":[5,6]},{"verseKey":"89:18","wordPositions":[1,2,3,4,5,6]},{"verseKey":"89:19","wordPositions":[1]}],"text":"ٱلْيَتِيمَ ﴿17﴾ وَلَا تَحَٰٓضُّونَ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ ﴿18﴾ وَتَأْكُلُونَ","isBasmala":false,"isSuraStart":false},{"lineNumber":14,"segments":[{"verseKey":"89:19","wordPositions":[2,3,4,5]},{"verseKey":"89:20","wordPositions":[1,2,3,4,5]},{"verseKey":"89:21","wordPositions":[1,2]}],"text":"ٱلتُّرَاثَ أَكْلًا لَّمًّا ﴿19﴾ وَتُحِبُّونَ ٱلْمَالَ حُبًّا جَمًّا ﴿20﴾ كَلَّآ إِذَا","isBasmala":false,"isSuraStart":false},{"lineNumber":15,"segments":[{"verseKey":"89:21","wordPositions":[3,4,5,6,7]},{"verseKey":"89:22","wordPositions":[1,2,3,4,5,6]}],"text":"دُكَّتِ ٱلْأَرْضُ دَكًّا دَكًّا ﴿21﴾ وَجَآءَ رَبُّكَ وَٱلْمَلَكُ صَفًّا صَفًّا ﴿22﴾","isBasmala":false,"isSuraStart":false}]}