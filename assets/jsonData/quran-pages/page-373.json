{"pageNumber":373,"ayas":[{"top":"+ 5","customMotashabehat":[],"index":137,"id":3069,"text":"إِنْ هَٰذَآ إِلَّا خُلُقُ ٱلْأَوَّلِينَ","text_without_tashkeel":"إن هذا إلا خلق الأولين","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":138,"id":3070,"text":"وَمَا نَحْنُ بِمُعَذَّبِينَ","text_without_tashkeel":"وما نحن بمعذبين","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":139,"id":3071,"text":"فَكَذَّبُوهُ فَأَهْلَكْنَٰهُمْ إِنَّ فِى ذَٰلِكَ لَءَايَةً وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَ","text_without_tashkeel":"فكذبوه فأهلكناهم إن في ذلك لآية وما كان أكثرهم مؤمنين","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":140,"id":3072,"text":"وَإِنَّ رَبَّكَ لَهُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ","text_without_tashkeel":"وإن ربك لهو العزيز الرحيم","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":141,"id":3073,"text":"كَذَّبَتْ ثَمُودُ ٱلْمُرْسَلِينَ","text_without_tashkeel":"كذبت ثمود المرسلين","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":142,"id":3074,"text":"إِذْ قَالَ لَهُمْ أَخُوهُمْ صَٰلِحٌ أَلَا تَتَّقُونَ","text_without_tashkeel":"إذ قال لهم أخوهم صالح ألا تتقون","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":143,"id":3075,"text":"إِنِّى لَكُمْ رَسُولٌ أَمِينٌ","text_without_tashkeel":"إني لكم رسول أمين","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":144,"id":3076,"text":"فَٱتَّقُوا۟ ٱللَّهَ وَأَطِيعُونِ","text_without_tashkeel":"فاتقوا الله وأطيعون","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":145,"id":3077,"text":"وَمَآ أَسْـَٔلُكُمْ عَلَيْهِ مِنْ أَجْرٍ إِنْ أَجْرِىَ إِلَّا عَلَىٰ رَبِّ ٱلْعَٰلَمِينَ","text_without_tashkeel":"وما أسألكم عليه من أجر إن أجري إلا على رب العالمين","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":146,"id":3078,"text":"أَتُتْرَكُونَ فِى مَا هَٰهُنَآ ءَامِنِينَ","text_without_tashkeel":"أتتركون في ما هاهنا آمنين","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":147,"id":3079,"text":"فِى جَنَّٰ