{"pageNumber":569,"ayas":[{"top":"+ 5","customMotashabehat":[],"index":11,"id":5386,"text":"يُبَصَّرُونَهُمْ يَوَدُّ ٱلْمُجْرِمُ لَوْ يَفْتَدِى مِنْ عَذَابِ يَوْمِئِذٍۭ بِبَنِيهِ","text_without_tashkeel":"يبصرونهم يود المجرم لو يفتدي من عذاب يومئذ ببنيه","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":12,"id":5387,"text":"وَصَٰحِبَتِهِۦ وَأَخِيهِ","text_without_tashkeel":"وصاحبته وأخيه","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":13,"id":5388,"text":"وَفَصِيلَتِهِ ٱلَّتِى تُـْٔوِيهِ","text_without_tashkeel":"وفصيلته التي تؤويه","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":14,"id":5389,"text":"وَمَن فِى ٱلْأَرْضِ جَمِيعًا ثُمَّ يُنجِيهِ","text_without_tashkeel":"ومن في الأرض جميعا ثم ينجيه","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":15,"id":5390,"text":"كَلَّآ إِنَّهَا لَظَىٰ","text_without_tashkeel":"كلا إنها لظى","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":16,"id":5391,"text":"نَزَّاعَةً لِّلشَّوَىٰ","text_without_tashkeel":"نزاعة للشوى","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":17,"id":5392,"text":"تَدْعُوا۟ مَنْ أَدْبَرَ وَتَوَلَّىٰ","text_without_tashkeel":"تدعو من أدبر وتولى","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":18,"id":5393,"text":"وَجَمَعَ فَأَوْعَىٰٓ","text_without_tashkeel":"وجمع فأوعى","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":19,"id":5394,"text":"إِنَّ ٱلْإِنسَٰنَ خُلِقَ هَلُوعًا","text_without_tashkeel":"إن الإنسان خلق هلوعا","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":20,"id":5395,"text":"إِذَا مَسَّهُ ٱلشَّرُّ جَزُوعًا","text_without_tashkeel":"إذا مسه الشر جزوعا","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":21,"id":5396,"text":"وَإِذَا مَسَّهُ ٱلْخَيْرُ مَنُوعًا","text_without_tashkeel":"وإذا مسه الخير منوعا","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":22,"id":5397,"text":"إِلَّا ٱلْمُصَلِّينَ","text_without_tashkeel":"إلا المصلين","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":23,"id":5398,"text":"ٱلَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ دَآئِمُونَ","text_without_tashkeel":"الذين هم على صلاتهم دائمون","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":24,"id":5399,"text":"وَٱلَّذِينَ فِىٓ أَمْوَٰلِهِمْ حَقٌّ مَّعْلُومٌ","text_without_tashkeel":"والذين في أموالهم حق معلوم","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":25,"id":5400,"text":"لِّلسَّآئِلِ وَٱلْمَحْرُومِ","text_without_tashkeel":"للسائل والمحروم","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":26,"id":5401,"text":"وَٱلَّذِينَ يُصَدِّقُونَ بِيَوْمِ ٱلدِّينِ","text_without_tashkeel":"والذين يصدقون بيوم الدين","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":27,"id":5402,"text":"وَٱلَّذِينَ هُم مِّنْ عَذَابِ رَبِّهِم مُّشْفِقُونَ","text_without_tashkeel":"والذين هم من عذاب ربهم مشفقون","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":28,"id":5403,"text":"إِنَّ عَذَابَ رَبِّهِمْ غَيْرُ مَأْمُونٍ","text_without_tashkeel":"إن عذاب ربهم غير مأمون","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":29,"id":5404,"text":"وَٱلَّذِينَ هُمْ لِفُرُوجِهِمْ حَٰفِظُونَ","text_without_tashkeel":"والذين هم لفروجهم حافظون","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":30,"id":5405,"text":"إِلَّا عَلَىٰٓ أَزْوَٰجِهِمْ أَوْ مَا مَلَكَتْ أَيْمَٰنُهُمْ فَإِنَّهُمْ غَيْرُ مَلُومِينَ","text_without_tashkeel":"إلا على أزواجهم أو ما ملكت أيمانهم فإنهم غير ملومين","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":31,"id":5406,"text":"فَمَنِ ٱبْتَغَىٰ وَرَآءَ ذَٰلِكَ فَأُو۟لَٰٓئِكَ هُمُ ٱلْعَادُونَ","text_without_tashkeel":"فمن ابتغى وراء ذلك فأولئك هم العادون","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":32,"id":5407,"text":"وَٱلَّذِينَ هُمْ لِأَمَٰنَٰتِهِمْ وَعَهْدِهِمْ رَٰعُونَ","text_without_tashkeel":"والذين هم لأماناتهم وعهدهم راعون","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":33,"id":5408,"text":"وَٱل