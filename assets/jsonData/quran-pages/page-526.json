{"pageNumber":526,"ayas":[{"top":"+ 5","customMotashabehat":[],"index":1,"id":4785,"text":"وَٱلنَّجْمِ إِذَا هَوَىٰ","text_without_tashkeel":"والنجم إذا هوى","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":2,"id":4786,"text":"مَا ضَلَّ صَاحِبُكُمْ وَمَا غَوَىٰ","text_without_tashkeel":"ما ضل صاحبكم وما غوى","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":3,"id":4787,"text":"وَمَا يَنطِقُ عَنِ ٱلْهَوَىٰٓ","text_without_tashkeel":"وما ينطق عن الهوى","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":4,"id":4788,"text":"إِنْ هُوَ إِلَّا وَحْىٌ يُوحَىٰ","text_without_tashkeel":"إن هو إلا وحي يوحى","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":5,"id":4789,"text":"عَلَّمَهُۥ شَدِيدُ ٱلْقُوَىٰ","text_without_tashkeel":"علمه شديد القوى","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":6,"id":4790,"text":"ذُو مِرَّةٍ فَٱسْتَوَىٰ","text_without_tashkeel":"ذو مرة فاستوى","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":7,"id":4791,"text":"وَهُوَ بِٱلْأُفُقِ ٱلْأَعْلَىٰ","text_without_tashkeel":"وهو بالأفق الأعلى","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":8,"id":4792,"text":"ثُمَّ دَنَا فَتَدَلَّىٰ","text_without_tashkeel":"ثم دنا فتدلى","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":9,"id":4793,"text":"فَكَانَ قَابَ قَوْسَيْنِ أَوْ أَدْنَىٰ","text_without_tashkeel":"فكان قاب قوسين أو أدنى","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":10,"id":4794,"text":"فَأَوْحَىٰٓ إِلَىٰ عَبْدِهِۦ مَآ أَوْحَىٰ","text_without_tashkeel":"فأوحى إلى عبده ما أوحى","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":11,"id":4795,"text":"مَا كَذَبَ ٱلْفُؤَادُ مَا رَأَىٰٓ","text_without_tashkeel":"ما كذب الفؤاد ما رأى","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":12,"id":4796,"text":"أَفَتُمَٰرُونَهُۥ عَلَىٰ مَا يَرَىٰ","text_without_tashkeel":"أفتمارونه على ما يرى","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":13,"id":4797,"text":"وَلَقَدْ رَءَاهُ نَزْلَةً أُخْرَىٰ","text_without_tashkeel":"ولقد رآه نزلة أخرى","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":14,"id":4798,"text":"عِندَ سِدْرَةِ ٱلْمُنتَهَىٰ","text_without_tashkeel":"عند سدرة المنتهى","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":15,"id":4799,"text":"عِندَهَا جَنَّةُ ٱلْمَأْوَىٰٓ","text_without_tashkeel":"عندها جنة المأوى","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":16,"id":4800,"text":"إِذْ يَغْشَى ٱلسِّدْرَةَ مَا يَغْشَىٰ","text_without_tashkeel":"إذ يغشى السدرة ما يغشى","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":17,"id":4801,"text":"مَا زَاغَ ٱلْبَصَرُ وَمَا طَغَىٰ","text_without_tashkeel":"ما زاغ البصر وما طغى","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":18,"id":4802,"text":"لَقَدْ رَأَىٰ مِنْ ءَايَٰتِ رَبِّهِ ٱلْكُبْرَىٰٓ","text_without_tashkeel":"لقد رأى من آيات ربه الكبرى","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":19,"id":4803,"text":"أَفَرَءَيْتُمُ ٱللَّٰتَ وَٱلْعُزَّىٰ","text_without_tashkeel":"أفرأيتم اللات والعزى","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":20,"id":4804,"text":"وَمَنَوٰةَ ٱلثَّالِثَةَ ٱلْأُخْرَىٰٓ","text_without_tashkeel":"ومناة الثالثة الأخرى","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":21,"id":4805,"text":"أَلَكُمُ ٱلذَّكَرُ وَلَهُ ٱلْأُنثَىٰ","text_without_tashkeel":"ألكم الذكر وله الأنثى","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":22,"id":4806,"text":"تِلْكَ إِذًا قِسْمَةٌ ضِيزَىٰٓ","text_without_tashkeel":"تلك إذا قسمة ضيزى","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":23,"id":4807,"text":"إِنْ هِىَ إِلَّآ أَسْمَآءٌ سَمَّيْتُمُوهَآ أَنتُمْ وَءَابَآؤُكُم مَّآ أَنزَلَ ٱللَّهُ بِهَا مِن سُلْطَٰنٍ إِن يَتَّبِعُونَ إِلَّا ٱلظَّنَّ وَمَا تَهْوَى ٱلْأَنفُسُ وَلَقَدْ جَآءَهُم مِّن رَّبِّهِمُ ٱلْهُدَىٰٓ","text_without_tashkeel":"إن هي إلا أسماء سميتموها أنتم وآباؤكم ما أنزل الله بها من سلطان إن يتبعون إلا الظن وما تهوى الأنفس ولقد جاءهم من ربهم الهدى","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":24,"id":4808,"text":"أَمْ لِلْإِنسَٰنِ مَا تَمَنَّىٰ","text_without_tashkeel":"أم للإنسان ما تمنى","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":25,"id":4809,"text":"فَلِلَّهِ ٱلْءَاخِرَةُ وَٱلْأُولَىٰ","text_without_tashkeel":"فلله الآخرة والأولى","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":26,"id":4810,"text":"وَكَم مِّن مَّلَكٍ فِى ٱلسَّمَٰوَٰتِ لَا تُغْنِى شَفَٰعَتُهُمْ شَيْـًٔا إِلَّا مِنۢ بَعْدِ أَن يَأْذَنَ ٱللَّهُ لِمَن يَشَآءُ وَيَرْضَىٰٓ","text_without_tashkeel":"وكم من ملك في السماوات لا تغني شفاعتهم شيئا إلا من بعد أن يأذن الله لمن يشاء ويرضى","errorFactor":""}]}