{"pageNumber":578,"ayas":[{"top":"+ 5","customMotashabehat":[],"index":20,"id":5571,"text":"كَلَّا بَلْ تُحِبُّونَ ٱلْعَاجِلَةَ","text_without_tashkeel":"كلا بل تحبون العاجلة","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":21,"id":5572,"text":"وَتَذَرُونَ ٱلْءَاخِرَةَ","text_without_tashkeel":"وتذرون الآخرة","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":22,"id":5573,"text":"وُجُوهٌ يَوْمَئِذٍ نَّاضِرَةٌ","text_without_tashkeel":"وجوه يومئذ ناضرة","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":23,"id":5574,"text":"إِلَىٰ رَبِّهَا نَاظِرَةٌ","text_without_tashkeel":"إلى ربها ناظرة","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":24,"id":5575,"text":"وَوُجُوهٌ يَوْمَئِذٍۭ بَاسِرَةٌ","text_without_tashkeel":"ووجوه يومئذ باسرة","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":25,"id":5576,"text":"تَظُنُّ أَن يُفْعَلَ بِهَا فَاقِرَةٌ","text_without_tashkeel":"تظن أن يفعل بها فاقرة","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":26,"id":5577,"text":"كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِىَ","text_without_tashkeel":"كلا إذا بلغت التراقي","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":27,"id":5578,"text":"وَقِيلَ مَنْ رَاقٍ","text_without_tashkeel":"وقيل من راق","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":28,"id":5579,"text":"وَظَنَّ أَنَّهُ ٱلْفِرَاقُ","text_without_tashkeel":"وظن أنه الفراق","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":29,"id":5580,"text":"وَٱلْتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ","text_without_tashkeel":"والتفت الساق بالساق","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":30,"id":5581,"text":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمَسَاقُ","text_without_tashkeel":"إلى ربك يومئذ المساق","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":31,"id":5582,"text":"فَلَا صَدَّقَ وَلَا صَلَّىٰ","text_without_tashkeel":"فلا صدق ولا صلى","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":32,"id":5583,"text"