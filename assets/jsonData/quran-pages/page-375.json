{"pageNumber":375,"ayas":[{"top":"+ 5","customMotashabehat":[],"index":184,"id":3116,"text":"وَٱتَّقُوا۟ ٱلَّذِى خَلَقَكُمْ وَٱلْجِبِلَّةَ ٱلْأَوَّلِينَ","text_without_tashkeel":"واتقوا الذي خلقكم والجبلة الأولين","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":185,"id":3117,"text":"قَالُوٓا۟ إِنَّمَآ أَنتَ مِنَ ٱلْمُسَحَّرِينَ","text_without_tashkeel":"قالوا إنما أنت من المسحرين","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":186,"id":3118,"text":"وَمَآ أَنتَ إِلَّا بَشَرٌ مِّثْلُنَا وَإِن نَّظُنُّكَ لَمِنَ ٱلْكَٰذِبِينَ","text_without_tashkeel":"وما أنت إلا بشر مثلنا وإن نظنك لمن الكاذبين","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":187,"id":3119,"text":"فَأَسْقِطْ عَلَيْنَا كِسَفًا مِّنَ ٱلسَّمَآءِ إِن كُنتَ مِنَ ٱلصَّٰدِقِينَ","text_without_tashkeel":"فأسقط علينا كسفا من السماء إن كنت من الصادقين","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":188,"id":3120,"text":"قَالَ رَبِّىٓ أَعْلَمُ بِمَا تَعْمَلُونَ","text_without_tashkeel":"قال ربي أعلم بما تعملون","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":189,"id":3121,"text":"فَكَذَّبُوهُ فَأَخَذَهُمْ عَذَابُ يَوْمِ ٱلظُّلَّةِ إِنَّهُۥ كَانَ عَذَابَ يَوْمٍ عَظِيمٍ","text_without_tashkeel":"فكذبوه فأخذهم عذاب يوم الظلة إنه كان عذاب يوم عظيم","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":190,"id":3122,"text":"إِنَّ فِى ذَٰلِكَ لَءَايَةً وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَ","text_without_tashkeel":"إن في ذلك لآية وما كان أكثرهم مؤمنين","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":191,"id":3123,"text":"وَإِنَّ رَبَّكَ لَهُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ","text_without_tashkeel":"وإن ربك لهو العزيز الرحيم","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":192,"id":3124,"text":"وَإِنَّهُۥ لَتَنزِيلُ رَبِّ ٱلْعَٰلَمِينَ","text_without_tashkeel":"وإنه لتنزيل رب العالمين","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":193,"id":3125,"text":"نَزَلَ بِهِ ٱلرُّوحُ ٱلْأَمِينُ","text_witho