{"pageNumber":599,"ayas":[{"top":"+ 5","customMotashabehat":[],"index":8,"id":6138,"text":"جَزَآؤُهُمْ عِندَ رَبِّهِمْ جَنَّٰتُ عَدْنٍ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَٰرُ خَٰلِدِينَ فِيهَآ أَبَدًا رَّضِىَ ٱللَّهُ عَنْهُمْ وَرَضُوا۟ عَنْهُ ذَٰلِكَ لِمَنْ خَشِىَ رَبَّهُۥ","text_without_tashkeel":"جزاؤهم عند ربهم جنات عدن تجري من تحتها الأنهار خالدين فيها أبدا رضي الله عنهم ورضوا عنه ذلك لمن خشي ربه","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":1,"id":6139,"text":"إِذَا زُلْزِلَتِ ٱلْأَرْضُ زِلْزَالَهَا","text_without_tashkeel":"إذا زلزلت الأرض زلزالها","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":2,"id":6140,"text":"وَأَخْرَجَتِ ٱلْأَرْضُ أَثْقَالَهَا","text_without_tashkeel":"وأخرجت الأرض أثقالها","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":3,"id":6141,"text":"وَقَالَ ٱلْإِنسَٰنُ مَا لَهَا","text_without_tashkeel":"وقال الإنسان ما لها","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":4,"id":6142,"text":"يَوْمَئِذٍ تُحَدِّثُ أَخْبَارَهَا","text_without_tashkeel":"يومئذ تحدث أخبارها","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":5,"id":6143,"text":"بِأَنَّ رَبَّكَ أَوْحَىٰ لَهَا","text_without_tashkeel":"بأن ربك أوحى لها","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":6,"id":6144,"text":"يَوْمَئِذٍ يَصْدُرُ ٱلنَّاسُ أَشْتَاتًا لِّيُرَوْا۟ أَعْمَٰلَهُمْ","text_without_tashkeel":"يومئذ يصدر الناس أشتاتا ليروا أعمالهم","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":7,"id":6145,"text":"فَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْرًا يَرَهُۥ","text_without_tashkeel":"فمن يعمل مثقال ذرة خيرا يره","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":8,"id":6146,"text":"وَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍ شَرًّا يَرَهُۥ","text_without_tashkeel":"ومن يعمل مثقال ذرة شرا يره","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":1,"id":6147,"text":"وَٱلْعَٰدِيَٰتِ ضَبْحًا","text_without_tashkeel":"والعاديات ضبحا","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":2,"id":6148,"text":"فَٱلْمُورِيَٰتِ قَدْحًا","text_without_tashkeel":"فالموريات قدحا","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":3,"id":6149,"text":"فَٱلْمُغِيرَٰتِ صُبْحًا","text_without_tashkeel":"فالمغيرات صبحا","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":4,"id":6150,"text":"فَأَثَرْنَ بِهِۦ نَقْعًا","text_without_tashkeel":"فأثرن به نقعا","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":5,"id":6151,"text":"فَوَسَطْنَ بِهِۦ جَمْعًا","text_without_tashkeel":"فوسطن به جمعا","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":6,"id":6152,"text":"إِنَّ ٱلْإِنسَٰنَ لِرَبِّهِۦ لَكَنُودٌ","text_without_tashkeel":"إن الإنسان لربه لكنود","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":7,"id":6153,"text":"وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٌ","text_without_tashkeel":"وإنه على ذلك لشهيد","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":8,"id":6154,"text":"وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ لَشَدِيدٌ","text_without_tashkeel":"وإنه لحب الخير لشديد","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":9,"id":6155,"text":"أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى ٱلْقُبُورِ","text_without_tashkeel":"أفلا يعلم إذا بعثر ما في القبور","errorFactor":""}]}