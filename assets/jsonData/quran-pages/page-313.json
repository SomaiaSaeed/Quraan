{"pageNumber":313,"ayas":[{"top":"+ 5","customMotashabehat":[],"index":13,"id":2361,"text":"وَأَنَا ٱخْتَرْتُكَ فَٱسْتَمِعْ لِمَا يُوحَىٰٓ","text_without_tashkeel":"وأنا اخترتك فاستمع لما يوحى","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":14,"id":2362,"text":"إِنَّنِىٓ أَنَا ٱللَّهُ لَآ إِلَٰهَ إِلَّآ أَنَا۠ فَٱعْبُدْنِى وَأَقِمِ ٱلصَّلَوٰةَ لِذِكْرِىٓ","text_without_tashkeel":"إنني أنا الله لا إله إلا أنا فاعبدني وأقم الصلاة لذكري","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":15,"id":2363,"text":"إِنَّ ٱلسَّاعَةَ ءَاتِيَةٌ أَكَادُ أُخْفِيهَا لِتُجْزَىٰ كُلُّ نَفْسٍۭ بِمَا تَسْعَىٰ","text_without_tashkeel":"إن الساعة آتية أكاد أخفيها لتجزى كل نفس بما تسعى","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":16,"id":2364,"text":"فَلَا يَصُدَّنَّكَ عَنْهَا مَن لَّا يُؤْمِنُ بِهَا وَٱتَّبَعَ هَوَىٰهُ فَتَرْدَىٰ","text_without_tashkeel":"فلا يصدنك عنها من لا يؤمن بها واتبع هواه فتردى","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":17,"id":2365,"text":"وَمَا تِلْكَ بِيَمِينِكَ يَٰمُوسَىٰ","text_without_tashkeel":"وما تلك بيمينك يا موسى","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":18,"id":2366,"text":"قَالَ هِىَ عَصَاىَ أَتَوَكَّؤُا۟ عَلَيْهَا وَأَهُشُّ بِهَا عَلَىٰ غَنَمِى وَلِىَ فِيهَا مَـَٔارِبُ أُخْرَىٰ","text_without_tashkeel":"قال هي عصاي أتوكأ عليها وأهش بها على غنمي ولي فيها مآرب أخرى","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":19,"id":2367,"text":"قَالَ أَلْقِهَا يَٰمُوسَىٰ","text_without_tashkeel":"قال ألقها يا موسى","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":20,"id":2368,"text":"فَأَلْقَىٰهَا فَإِذَا هِىَ حَيَّةٌ تَسْعَىٰ","text_without_tashkeel":"فألقاها فإذا هي حية تسعى","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":21,"id":2369,"text":"قَالَ خُذْهَا وَلَا تَخَفْ سَنُعِيدُهَا سِيرَتَهَا ٱلْأُولَىٰ","text_without_tashkeel":"قال خذها ولا تخف سنعيدها سيرتها الأولى","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":22,"id":2370,"text":"وَٱضْمُمْ يَدَكَ إِلَىٰ جَنَاحِكَ تَخْرُجْ بَيْضَآءَ مِنْ غَيْرِ سُوٓءٍ ءَايَةً أُخْرَىٰ","text_without_tashkeel":"واضمم يدك إلى جناحك تخرج بيضاء من غير سوء آية أخرى","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":23,"id":2371,"text":"لِنُرِيَكَ مِنْ ءَايَٰتِنَا ٱلْكُبْرَى","text_without_tashkeel":"لنريك من آياتنا الكبرى","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":24,"id":2372,"text":"ٱذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ","text_without_tashkeel":"اذهب إلى فرعون إنه طغى","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":25,"id":2373,"text":"قَالَ رَبِّ ٱشْرَحْ لِى صَدْرِى","text_without_tashkeel":"قال رب اشرح لي صدري","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":26,"id":2374,"text":"وَيَسِّرْ لِىٓ أَمْرِى","text_without_tashkeel":"ويسر لي أمري","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":27,"id":2375,"text":"وَٱحْلُلْ عُقْدَةً مِّن لِّسَانِى","text_without_tashkeel":"واحلل عقدة من لساني","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":28,"id":2376,"text":"يَفْقَهُوا۟ قَوْلِى","text_without_tashkeel":"يفقهوا قولي","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":29,"id":2377,"text":"وَٱجْعَل لِّى وَزِيرًا مِّنْ أَهْلِى","text_without_tashkeel":"واجعل لي وزيرا من أهلي","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":30,"id":2378,"text":"هَٰرُونَ أَخِى","text_without_tashkeel":"هارون أخي","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":31,"id":2379,"text":"ٱشْدُدْ بِهِۦٓ أَزْرِى","text_without_tashkeel":"اشدد به أزري","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":32,"id":2380,"text":"وَأَشْرِكْهُ فِىٓ أَمْرِى","text_without_tashkeel":"وأشركه في أمري","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":33,"id":2381,"text":"كَىْ نُسَبِّحَكَ كَثِيرًا","text_without_tashkeel":"كي نسبحك كثيرا","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":34,"id":2382,"text":"وَنَذْكُرَكَ كَثِيرًا","text_without_tashkeel":"ونذكرك كثيرا","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":35,"id":2383,"text":"إِنَّكَ كُنتَ بِنَا بَصِيرًا","text_without_tashkeel":"إنك كنت بنا بصيرا","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":36,"id":2384,"text":"قَالَ قَدْ أُوتِيتَ سُؤْلَكَ يَٰمُوسَىٰ","text_without_tashkeel":"قال قد أوتيت سؤلك يا موسى","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":37,"id":2385,"text":"وَلَقَدْ مَنَنَّا عَلَيْكَ مَرَّةً أُخْرَىٰٓ","text_without_tashkeel":"ولقد مننا عليك مرة أخرى","errorFactor":""}]}