{"pageNumber":266,"ayas":[{"top":"+ 5","customMotashabehat":[],"index":71,"id":1873,"text":"قَالَ هَٰٓؤُلَآءِ بَنَاتِىٓ إِن كُنتُمْ فَٰعِلِينَ","text_without_tashkeel":"قال هؤلاء بناتي إن كنتم فاعلين","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":72,"id":1874,"text":"لَعَمْرُكَ إِنَّهُمْ لَفِى سَكْرَتِهِمْ يَعْمَهُونَ","text_without_tashkeel":"لعمرك إنهم لفي سكرتهم يعمهون","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":73,"id":1875,"text":"فَأَخَذَتْهُمُ ٱلصَّيْحَةُ مُشْرِقِينَ","text_without_tashkeel":"فأخذتهم الصيحة مشرقين","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":74,"id":1876,"text":"فَجَعَلْنَا عَٰلِيَهَا سَافِلَهَا وَأَمْطَرْنَا عَلَيْهِمْ حِجَارَةً مِّن سِجِّيلٍ","text_without_tashkeel":"فجعلنا عاليها سافلها وأمطرنا عليهم حجارة من سجيل","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":75,"id":1877,"text":"إِنَّ فِى ذَٰلِكَ لَءَايَٰتٍ لِّلْمُتَوَسِّمِينَ","text_without_tashkeel":"إن في ذلك لآيات للمتوسمين","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":76,"id":1878,"text":"وَإِنَّهَا لَبِسَبِيلٍ مُّقِيمٍ","text_without_tashkeel":"وإنها لبسبيل مقيم","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":77,"id":1879,"text":"إِنَّ فِى ذَٰلِكَ لَءَايَةً لِّلْمُؤْمِنِينَ","text_without_tashkeel":"إن في ذلك لآية للمؤمنين","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":78,"id":1880,"text":"وَإِن كَانَ أَصْحَٰبُ ٱلْأَيْكَةِ لَظَٰلِمِينَ","text_without_tashkeel":"وإن كان أصحاب الأيكة لظالمين","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":79,"id":1881,"text":"فَٱنتَقَمْنَا مِنْهُمْ وَإِنَّهُمَا لَبِإِمَامٍ مُّبِينٍ","text_without_tashkeel":"فانتقمنا منهم وإنهما لبإمام مبين","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":80,"id":1882,"text":"وَلَقَدْ كَذَّبَ أَصْحَٰبُ ٱلْحِجْرِ ٱلْمُرْسَلِينَ","text_without_tashkeel":"ولقد كذب أصحاب الحجر المرسلين","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":81,"id":1883,"text":"وَءَاتَيْنَٰهُمْ ءَايَٰتِنَا فَكَانُوا۟ عَنْهَا مُعْرِضِينَ","text_without_tashkeel":"وآتيناهم آياتنا فكانوا عنها معرضين","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":82,"id":1884,"text":"وَكَانُوا۟ يَنْحِتُونَ مِنَ ٱلْجِبَالِ بُيُوتًا ءَامِنِينَ","text_without_tashkeel":"وكانوا ينحتون من الجبال بيوتا آمنين","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":83,"id":1885,"text":"فَأَخَذَتْهُمُ ٱلصَّيْحَةُ مُصْبِحِينَ","text_without_tashkeel":"فأخذتهم الصيحة مصبحين","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":84,"id":1886,"text":"فَمَآ أَغْنَىٰ عَنْهُم مَّا كَانُوا۟ يَكْسِبُونَ","text_without_tashkeel":"فما أغنى عنهم ما كانوا يكسبون","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":85,"id":1887,"text":"وَمَا خَلَقْنَا ٱلسَّمَٰوَٰتِ وَٱلْأَرْضَ وَمَا بَيْنَهُمَآ إِلَّا بِٱلْحَقِّ وَإِنَّ ٱلسَّاعَةَ لَءَاتِيَةٌ فَٱصْفَحِ ٱلصَّفْحَ ٱلْجَمِيلَ","text_without_tashkeel":"وما خلقنا السماوات والأرض وما بينهما إلا بالحق وإن الساعة لآتية فاصفح الصفح الجميل","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":86,"id":1888,"text":"إِنَّ رَبَّكَ هُوَ ٱلْخَلَّٰقُ ٱلْعَلِيمُ","text_without_tashkeel":"إن ربك هو الخلاق العليم","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":87,"id":1889,"text":"وَلَقَدْ ءَاتَيْنَٰكَ سَبْعًا مِّنَ ٱلْمَثَانِى وَٱلْقُرْءَانَ ٱلْعَظِيمَ","text_without_tashkeel":"ولقد آتيناك سبعا من المثاني والقرآن العظيم","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":88,"id":1890,"text":"لَا تَمُدَّنَّ عَيْنَيْكَ إِلَىٰ مَا مَتَّعْنَا بِهِۦٓ أَزْوَٰجًا مِّنْهُمْ وَلَا تَحْزَنْ عَلَيْهِمْ وَٱخْفِضْ جَنَاحَكَ لِلْمُؤْمِنِينَ","text_without_tashkeel":"لا تمدن عينيك إلى ما متعنا به أزواجا منهم ولا تحزن عليهم واخفض جناحك للمؤمنين","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":89,"id":1891,"text":"وَقُلْ إِنِّىٓ أَنَا ٱلنَّذِيرُ ٱلْمُبِينُ","text_without_tashkeel":"وقل إني أنا النذير المبين","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":90,"id":1892,"text":"كَمَآ أَنزَلْنَا عَلَى ٱلْمُقْتَسِمِينَ","text_without_tashkeel":"كما أنزلنا على المقتسمين","errorFactor":""}]}