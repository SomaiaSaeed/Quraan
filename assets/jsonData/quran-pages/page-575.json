{"pageNumber":575,"ayas":[{"top":"+ 5","customMotashabehat":[],"index":20,"id":5495,"text":"إِنَّ رَبَّكَ يَعْلَمُ أَنَّكَ تَقُومُ أَدْنَىٰ مِن ثُلُثَىِ ٱلَّيْلِ وَنِصْفَهُۥ وَثُلُثَهُۥ وَطَآئِفَةٌ مِّنَ ٱلَّذِينَ مَعَكَ وَٱللَّهُ يُقَدِّرُ ٱلَّيْلَ وَٱلنَّهَارَ عَلِمَ أَن لَّن تُحْصُوهُ فَتَابَ عَلَيْكُمْ فَٱقْرَءُوا۟ مَا تَيَسَّرَ مِنَ ٱلْقُرْءَانِ عَلِمَ أَن سَيَكُونُ مِنكُم مَّرْضَىٰ وَءَاخَرُونَ يَضْرِبُونَ فِى ٱلْأَرْضِ يَبْتَغُونَ مِن فَضْلِ ٱللَّهِ وَءَاخَرُونَ يُقَٰتِلُونَ فِى سَبِيلِ ٱللَّهِ فَٱقْرَءُوا۟ مَا تَيَسَّرَ مِنْهُ وَأَقِيمُوا۟ ٱلصَّلَوٰةَ وَءَاتُوا۟ ٱلزَّكَوٰةَ وَأَقْرِضُوا۟ ٱللَّهَ قَرْضًا حَسَنًا وَمَا تُقَدِّمُوا۟ لِأَنفُسِكُم مِّنْ خَيْرٍ تَجِدُوهُ عِندَ ٱللَّهِ هُوَ خَيْرًا وَأَعْظَمَ أَجْرًا وَٱسْتَغْفِرُوا۟ ٱللَّهَ إِنَّ ٱللَّهَ غَفُورٌ رَّحِيمٌۢ","text_without_tashkeel":"إن ربك يعلم أنك تقوم أدنى من ثلثي الليل ونصفه وثلثه وطائفة من الذين معك والله يقدر الليل والنهار علم أن لن تحصوه فتاب عليكم فاقرءوا ما تيسر من القرآن علم أن سيكون منكم مرضى وآخرون يضربون في الأرض يبتغون من فضل الله وآخرون يقاتلون في سبيل الله فاقرءوا ما تيسر منه وأقيموا الصلاة وآتوا الزكاة وأقرضوا الله قرضا حسنا وما تقدموا لأنفسكم من خير تجدوه عند الله هو خيرا وأعظم أجرا واستغفروا الله إن الله غفور رحيم","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":1,"id":5496,"text":"يَٰٓأَيُّهَا ٱلْمُدَّثِّرُ","text_without_tashkeel":"يا أيها المدثر","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":2,"id":5497,"text":"قُمْ فَأَنذِرْ","text_without_tashkeel":"قم فأنذر","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":3,"id":5498,"text":"وَرَبَّكَ فَكَبِّرْ","text_without_tashkeel":"وربك فكبر","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":4,"id":5499,"text":"وَثِيَابَكَ فَطَهِّرْ","text_without_tashkeel":"وثيابك فطهر","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":5,"id":5500,"text":"وَٱلرُّجْزَ فَٱهْجُرْ","text_without_tashkeel":"والرجز فاهجر","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":6,"id":5501,"text":"وَلَا تَمْنُن تَسْتَكْثِرُ","text_without_tashkeel":"ولا تمنن تستكثر","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":7,"id":5502,"text":"وَلِرَبِّكَ فَٱصْبِرْ","text_without_tashkeel":"ولربك فاصبر","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":8,"id":5503,"text":"فَإِذَا نُقِرَ فِى ٱلنَّاقُورِ","text_without_tashkeel":"فإذا نقر في الناقور","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":9,"id":5504,"text":"فَذَٰلِكَ يَوْمَئِذٍ يَوْمٌ عَسِيرٌ","text_without_tashkeel":"فذلك يومئذ يوم عسير","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":10,"id":5505,"text":"عَلَى ٱلْكَٰفِرِينَ غَيْرُ يَسِيرٍ","text_without_tashkeel":"على الكافرين غير يسير","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":11,"id":5506,"text":"ذَرْنِى وَمَنْ خَلَقْتُ وَحِيدًا","text_without_tashkeel":"ذرني ومن خلقت وحيدا","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":12,"id":5507,"text":"وَجَعَلْتُ لَهُۥ مَالًا مَّمْدُودًا","text_without_tashkeel":"وجعلت له مالا ممدودا","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":13,"id":5508,"text":"وَبَنِينَ شُهُودًا","text_without_tashkeel":"وبنين شهودا","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":14,"id":5509,"text":"وَمَهَّدتُّ لَهُۥ تَمْهِيدًا","text_without_tashkeel":"ومهدت له تمهيدا","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":15,"id":5510,"text":"ثُمَّ يَطْمَعُ أَنْ أَزِيدَ","text_without_tashkeel":"ثم يطمع أن أزيد","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":16,"id":5511,"text":"كَلَّآ إِنَّهُۥ كَانَ لِءَايَٰتِنَا عَنِيدًا","text_without_tashkeel":"كلا إنه كان لآياتنا عنيدا","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":17,"id":5512,"text":"سَأُرْهِقُهُۥ صَعُودًا","text_without_tashkeel":"سأرهقه صعودا","errorFactor":""}]}