{"pageNumber":498,"ayas":[{"top":"+ 5","customMotashabehat":[],"index":40,"id":4454,"text":"إِنَّ يَوْمَ ٱلْفَصْلِ مِيقَٰتُهُمْ أَجْمَعِينَ","text_without_tashkeel":"إن يوم الفصل ميقاتهم أجمعين","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":41,"id":4455,"text":"يَوْمَ لَا يُغْنِى مَوْلًى عَن مَّوْلًى شَيْـًٔا وَلَا هُمْ يُنصَرُونَ","text_without_tashkeel":"يوم لا يغني مولى عن مولى شيئا ولا هم ينصرون","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":42,"id":4456,"text":"إِلَّا مَن رَّحِمَ ٱللَّهُ إِنَّهُۥ هُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ","text_without_tashkeel":"إلا من رحم الله إنه هو العزيز الرحيم","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":43,"id":4457,"text":"إِنَّ شَجَرَتَ ٱلزَّقُّومِ","text_without_tashkeel":"إن شجرت الزقوم","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":44,"id":4458,"text":"طَعَامُ ٱلْأَثِيمِ","text_without_tashkeel":"طعام الأثيم","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":45,"id":4459,"text":"كَٱلْمُهْلِ يَغْلِى فِى ٱلْبُطُونِ","text_without_tashkeel":"كالمهل يغلي في البطون","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":46,"id":4460,"text":"كَغَلْىِ ٱلْحَمِيمِ","text_without_tashkeel":"كغلي الحميم","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":47,"id":4461,"text":"خُذُوهُ فَٱعْتِلُوهُ إِلَىٰ سَوَآءِ ٱلْجَحِيمِ","text_without_tashkeel":"خذوه فاعتلوه إلى سواء الجحيم","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":48,"id":4462,"text":"ثُمَّ صُبُّوا۟ فَوْقَ رَأْسِهِۦ مِنْ عَذَابِ ٱلْحَمِيمِ","text_without_tashkeel":"ثم صبوا فوق رأسه من عذاب الحميم","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":49,"id":4463,"text":"ذُقْ إِنَّكَ أَنتَ ٱلْعَزِيزُ ٱلْكَرِيمُ","text_without_tashkeel":"ذق إنك أنت العزيز الكريم","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":50,"id":4464,"text":"إِنَّ هَٰذَا مَا كُنتُم بِهِۦ تَمْتَرُونَ","text_without_tashkeel":"إن هذا ما كنتم به تمترون","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":51,"id":4465,"text":"إِنَّ ٱلْمُتَّقِينَ فِى مَقَامٍ أَمِينٍ","text_without_tashkeel":"إن المتقين في مقام أمين","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":52,"id":4466,"text":"فِى جَنَّٰتٍ وَعُيُونٍ","text_without_tashkeel":"في جنات وعيون","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":53,"id":4467,"text":"يَلْبَسُونَ مِن سُندُسٍ وَإِسْتَبْرَقٍ مُّتَقَٰبِلِينَ","text_without_tashkeel":"يلبسون من سندس وإستبرق متقابلين","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":54,"id":4468,"text":"كَذَٰلِكَ وَزَوَّجْنَٰهُم بِحُورٍ عِينٍ","text_without_tashkeel":"كذلك وزوجناهم بحور عين","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":55,"id":4469,"text":"يَدْعُونَ فِيهَا بِكُلِّ فَٰكِهَةٍ ءَامِنِينَ","text_without_tashkeel":"يدعون فيها بكل فاكهة آمنين","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":56,"id":4470,"text":"لَا يَذُوقُونَ فِيهَا ٱلْمَوْتَ إِلَّا ٱلْمَوْتَةَ ٱلْأُولَىٰ وَوَقَىٰهُمْ عَذَابَ ٱلْجَحِيمِ","text_without_tashkeel":"لا يذوقون فيها الموت إلا الموتة الأولى ووقاهم عذاب الجحيم","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":57,"id":4471,"text":"فَضْلًا مِّن رَّبِّكَ ذَٰلِكَ هُوَ ٱلْفَوْزُ ٱلْعَظِيمُ","text_without_tashkeel":"فضلا من ربك ذلك هو الفوز العظيم","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":58,"id":4472,"text":"فَإِنَّمَا يَسَّرْنَٰهُ بِلِسَانِكَ لَعَلَّهُمْ يَتَذَكَّرُونَ","text_without_tashkeel":"فإنما يسرناه بلسانك لعلهم يتذكرون","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":59,"id":4473,"text":"فَٱرْتَقِبْ إِنَّهُم مُّرْتَقِبُونَ","text_without_tashkeel":"فارتقب إنهم مرتقبون","errorFactor":""}]}