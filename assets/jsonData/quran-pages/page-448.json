{"pageNumber":448,"ayas":[{"top":"+ 5","customMotashabehat":[],"index":52,"id":3840,"text":"يَقُولُ أَءِنَّكَ لَمِنَ ٱلْمُصَدِّقِينَ","text_without_tashkeel":"يقول أإنك لمن المصدقين","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":53,"id":3841,"text":"أَءِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَٰمًا أَءِنَّا لَمَدِينُونَ","text_without_tashkeel":"أإذا متنا وكنا ترابا وعظاما أإنا لمدينون","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":54,"id":3842,"text":"قَالَ هَلْ أَنتُم مُّطَّلِعُونَ","text_without_tashkeel":"قال هل أنتم مطلعون","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":55,"id":3843,"text":"فَٱطَّلَعَ فَرَءَاهُ فِى سَوَآءِ ٱلْجَحِيمِ","text_without_tashkeel":"فاطلع فرآه في سواء الجحيم","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":56,"id":3844,"text":"قَالَ تَٱللَّهِ إِن كِدتَّ لَتُرْدِينِ","text_without_tashkeel":"قال تالله إن كدت لتردين","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":57,"id":3845,"text":"وَلَوْلَا نِعْمَةُ رَبِّى لَكُنتُ مِنَ ٱلْمُحْضَرِينَ","text_without_tashkeel":"ولولا نعمة ربي لكنت من المحضرين","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":58,"id":3846,"text":"أَفَمَا نَحْنُ بِمَيِّتِينَ","text_without_tashkeel":"أفما نحن بميتين","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":59,"id":3847,"text":"إِلَّا مَوْتَتَنَا ٱلْأُولَىٰ وَمَا نَحْنُ بِمُعَذَّبِينَ","text_without_tashkeel":"إلا موتتنا الأولى وما نحن بمعذبين","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":60,"id":3848,"text":"إِنَّ هَٰذَا لَهُوَ ٱلْفَوْزُ ٱلْعَظِيمُ","text_without_tashkeel":"إن هذا لهو الفوز العظيم","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":61,"id":3849,"text":"لِمِثْلِ هَٰذَا فَلْيَعْمَلِ ٱلْعَٰمِلُونَ","text_without_tashkeel":"لمثل هذا فليعمل العاملون","errorFactor":""},{"top":"+ 5","customMotashabehat":[],"index":62,"id":3850,"text":"أَذَٰلِكَ خَيْرٌ نُّزُلًا أَمْ شَجَرَةُ ٱلزَّقُّومِ","text_without_tashkeel":"أذلك خير